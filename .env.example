# Banco de dados (docker-compose)
POSTGRES_DB=epa_conciliacao
POSTGRES_USER=epa_app
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Segredo JWT (gere um valor aleatório longo; nunca reutilize este exemplo)
SECRET_KEY=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Modo desenvolvimento. A autenticação Microsoft Entra ID ainda depende da TI.
AUTH_MODE=development
ENVIRONMENT=development
MAX_UPLOAD_MB=20

# Para execução local sem Docker, use por exemplo:
# DATABASE_URL=sqlite:///./epa_dev.db
# STORAGE_PATH=./storage
# ALLOWED_ORIGINS=http://localhost:5173
